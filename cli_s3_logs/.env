# Configuration for all scripts in this folder (sourced by lib.sh).
# Bash syntax: later lines may use earlier variables.

REGION="eu-west-1"

FEEDER_PROFILE="feeder"
STORAGE_PROFILE="storage"
FEEDER_ACCOUNT_ID="111111111111"      # <- change
STORAGE_ACCOUNT_ID="222222222222"     # <- change

# IAM role or user you use for admin work in Storage. It stays allowed on the
# data lake bucket despite the Access-Grants-only bucket policy.
# Must be a ROLE or USER ARN (arn:aws:iam::...), NOT an sts assumed-role ARN.
# Wrong value = locked out of the bucket (only root can remove the policy).
STORAGE_ADMIN_ARN="arn:aws:iam::${STORAGE_ACCOUNT_ID}:role/CHANGE-ME"

# Bucket names are global — keep the account suffix or choose unique names.
DATALAKE_BUCKET="datalake-${STORAGE_ACCOUNT_ID}"
STORAGE_CT_BUCKET="cloudtrail-logs-datalake-${STORAGE_ACCOUNT_ID}"
ATHENA_RESULTS_BUCKET="athena-query-results-datalake-${STORAGE_ACCOUNT_ID}"
INVENTORY_BUCKET="access-grants-inventory-${STORAGE_ACCOUNT_ID}"

# Append-only grants history (CSV) written by the AccessGrantsInventory Lambda.
# The Glue table access_grants_history reads every file under GRANTS_CSV_PREFIX,
# so keep only this CSV there.
GRANTS_CSV_PREFIX="access-grants-history/"
GRANTS_CSV_KEY="${GRANTS_CSV_PREFIX}access_grants_history.csv"

# Days CloudTrail log files are kept in the Storage log bucket
LOG_RETENTION_DAYS=30

# Names (change only if they clash with existing resources)
STORAGE_TRAIL="StorageDataLakeTrail"
RAM_SHARE_NAME="S3AccessGrantsFeederShare"
GLUE_DATABASE="cloudtrail_logs"
ATHENA_WORKGROUP="cloudtrail-correlation"
